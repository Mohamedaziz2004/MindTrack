<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1100" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDashboardController">

    <left>
        <VBox prefWidth="180" spacing="15" styleClass="sidebar">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <children>
                        <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                            <image>
                                <Image url="@../logo.png" />
                            </image>
                        </ImageView>
                        <Label styleClass="app-title" text="Mind Track" />
                    </children>
                </HBox>

                <Button styleClass="sidebar-button" text="Journal" />
                <Button styleClass="sidebar-button" text="Goals" />
                <Button styleClass="sidebar-button" text="Exercises" />
                <Button styleClass="sidebar-button" text="Habits" />
                <Button styleClass="sidebar-button" text="Profile" />
                <Button styleClass="sidebar-button" text="Statistics" />
                <Button styleClass="sidebar-button-active" text="Admin" />
                <Button styleClass="sidebar-button" text="Settings" />
                <Button styleClass="sidebar-button" text="Log Out" onAction="#handleLogout" />

            </children>
            <padding>
                <Insets left="15" top="20" />
            </padding>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_RIGHT" styleClass="top-bar">
            <children>
                <Label styleClass="page-title" text="Admin Dashboard" />
                <HBox HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="profile-shortcut" onMouseClicked="#handleHeaderProfileClick">
                    <ImageView fx:id="headerProfileImageView" fitHeight="32" fitWidth="32" pickOnBounds="true" preserveRatio="true" />
                    <Label fx:id="headerEmailLabel" styleClass="profile-email" text="admin@email.com" />
                </HBox>
            </children>
            <padding>
                <Insets top="10" right="20" bottom="10" left="20" />
            </padding>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="main-content">
            <Label styleClass="section-title" text="All Users" />
            <TableView fx:id="usersTable" styleClass="admin-table">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
                    <TableColumn fx:id="nomColumn" text="Last Name" prefWidth="140" />
                    <TableColumn fx:id="prenomColumn" text="First Name" prefWidth="140" />
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="240" />
                    <TableColumn fx:id="ageColumn" text="Age" prefWidth="80" />
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="120" />
                    <TableColumn fx:id="actionColumn" text="Actions" prefWidth="160" />
                </columns>
            </TableView>
            <Label fx:id="messageLabel" styleClass="error-text" />
        </VBox>
    </center>

</BorderPane>

