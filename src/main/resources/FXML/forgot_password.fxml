<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.ForgotPasswordController"
           prefWidth="900" prefHeight="600"
           style="-fx-background-color: #1a1f3a;">

    <VBox alignment="CENTER" spacing="16" maxWidth="420" styleClass="glass-card">
        <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

        <Label text="Reset your password" styleClass="glass-title" style="-fx-font-size: 22px;"/>
        <Label text="We will send a one-time code to your email" styleClass="glass-subtitle"/>

        <!-- Step 1: Request code -->
        <VBox fx:id="requestPane" spacing="12" alignment="CENTER_LEFT">
            <Label text="Email" styleClass="glass-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" styleClass="glass-input"/>
            <Label fx:id="emailErrorLabel" text="" visible="false" managed="false" styleClass="input-error-label"/>

            <Label text="Security check" styleClass="glass-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Canvas fx:id="captchaCanvas" width="160" height="46"
                        style="-fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 4;"/>
                <Button text="⟳" onAction="#refreshCaptcha" prefWidth="36" prefHeight="36"
                        style="-fx-font-size: 14px; -fx-padding: 4 6;"/>
            </HBox>
            <TextField fx:id="captchaInput" promptText="Enter the text above" styleClass="glass-input"/>
            <Label fx:id="captchaErrorLabel" text="" visible="false" managed="false" styleClass="input-error-label"/>

            <Button fx:id="sendCodeButton" text="Send code" onAction="#handleSendCode"
                    maxWidth="Infinity" prefHeight="40" styleClass="accent-button"/>
        </VBox>

        <!-- Step 2: Verify code -->
        <VBox fx:id="verifyPane" spacing="12" alignment="CENTER_LEFT" visible="false" managed="false">
            <Label text="Verification code" styleClass="glass-label"/>
            <TextField fx:id="codeField" promptText="6-digit code" styleClass="glass-input"/>
            <Label fx:id="codeErrorLabel" text="" visible="false" managed="false" styleClass="input-error-label"/>
            <Button fx:id="verifyButton" text="Verify" onAction="#handleVerifyCode"
                    maxWidth="Infinity" prefHeight="40" styleClass="accent-button"/>
        </VBox>

        <!-- Step 3: Reset password -->
        <VBox fx:id="resetPane" spacing="12" alignment="CENTER_LEFT" visible="false" managed="false">
            <Label text="New password" styleClass="glass-label"/>
            <PasswordField fx:id="newPasswordField" promptText="New password" styleClass="glass-input"/>
            <VBox fx:id="resetPasswordMeterBox" spacing="2" visible="false" managed="false">
                <ProgressBar fx:id="resetPasswordStrengthBar" prefWidth="360" prefHeight="6" maxHeight="6"
                             styleClass="password-strength-bar" progress="0"/>
                <Label fx:id="resetPasswordStrengthLabel" text="Password strength" styleClass="glass-subtitle" style="-fx-font-size: 11px;"/>
            </VBox>
            <Label text="Confirm password" styleClass="glass-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" styleClass="glass-input"/>
            <Label fx:id="passwordMatchLabel" text="" visible="false" managed="false"
                   styleClass="password-match-label"/>
            <Label fx:id="passwordErrorLabel" text="" visible="false" managed="false" styleClass="input-error-label"/>
            <Button fx:id="resetButton" text="Update password" onAction="#handleResetPassword"
                    maxWidth="Infinity" prefHeight="40" styleClass="accent-button"/>
        </VBox>

        <Label fx:id="messageLabel" text="" wrapText="true" textAlignment="CENTER"
               style="-fx-font-size: 12px; -fx-text-fill: #ff6b6b;"/>

        <HBox alignment="CENTER" spacing="6">
            <Label text="Remember your password?" styleClass="glass-subtitle"/>
            <Hyperlink text="Back to login" onAction="#openLogin" styleClass="glass-link"/>
        </HBox>
    </VBox>
</StackPane>

