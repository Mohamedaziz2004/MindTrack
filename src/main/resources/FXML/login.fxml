<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.LoginController"
      prefWidth="1120" prefHeight="700" spacing="0">

    <!-- LEFT SIDE - SOLID COLOR PANEL WITH LOGIN FORM -->
    <VBox prefWidth="500" prefHeight="700"
          alignment="TOP_CENTER" spacing="0"
          style="-fx-background-color: #1a1f3a;">

        <padding><Insets top="24" right="32" bottom="18" left="32"/></padding>

        <!-- LOGO + TITLE AREA -->
        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 20 0 20 0;">

            <HBox spacing="12" alignment="CENTER">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image><Image url="@../logo.png"/></image>
                </ImageView>
                <Label text="MindTrack" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
            
            <Label text="Welcome back"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"
                   alignment="CENTER"/>
            
            <Label text="Sign in to continue your wellness journey"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);"
                   alignment="CENTER" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- FORM FIELDS -->
        <VBox spacing="12" style="-fx-padding: 0 0 12 0;">

            <!-- EMAIL -->
            <VBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Email"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.9);"/>
                <TextField fx:id="emailField" promptText="you@example.com"
                           styleClass="login-input"/>
                <Label fx:id="emailErrorLabel" text="" visible="false" managed="true"
                       styleClass="input-error-label"/>
            </VBox>

            <!-- PASSWORD -->
            <VBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Password"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.9);"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               styleClass="login-input"/>
                <Label fx:id="passwordErrorLabel" text="" visible="false" managed="true"
                       styleClass="input-error-label"/>
            </VBox>

            <!-- CAPTCHA -->
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Security check"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.9);"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Canvas fx:id="captchaCanvas" width="170" height="50"
                            style="-fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 4;"/>
                    <Button text="⟳" onAction="#refreshCaptcha"
                            prefWidth="36" prefHeight="36"
                            style="-fx-font-size: 14px; -fx-padding: 4 6;"/>
                </HBox>
                <TextField fx:id="captchaInput" promptText="Enter the text above"
                           styleClass="login-input"/>
                <Label fx:id="captchaErrorLabel" text="" visible="false" managed="true"
                       styleClass="input-error-label"/>
            </VBox>
        </VBox>

        <!-- BUTTONS -->
        <VBox spacing="10" style="-fx-padding: 0 0 16 0;">

            <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin"
                    maxWidth="Infinity" prefHeight="40"
                    styleClass="accent-button"
                    style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

            <!-- DIVIDER -->
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS" style="-fx-border-color: rgba(255,255,255,0.2);"/>
                <Label text="or" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                <Separator HBox.hgrow="ALWAYS" style="-fx-border-color: rgba(255,255,255,0.2);"/>
            </HBox>

            <!-- ALT AUTH -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Face ID" onAction="#handleFaceLogin"
                        styleClass="outline-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        prefHeight="34"/>
                <Button text="Google" onAction="#handleGoogleLogin"
                        styleClass="outline-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        prefHeight="34"/>
            </HBox>
        </VBox>

        <!-- MESSAGE LABEL -->
        <Label fx:id="messageLabel" wrapText="true" textAlignment="CENTER"
               style="-fx-font-size: 12px; -fx-text-fill: #ff6b6b;"
               maxWidth="300"/>

        <HBox alignment="CENTER" spacing="4" style="-fx-padding: 0 0 12 0;">
            <Hyperlink text="Forgot password?" onAction="#openForgotPassword"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>

        <!-- SPACER -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- SIGN UP LINK -->
        <HBox alignment="CENTER" spacing="4" style="-fx-padding: 0 0 16 0;">
            <Label text="No account?" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.7);"/>
            <Hyperlink text="Create one" onAction="#openRegister"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- RIGHT SIDE - VIDEO BACKGROUND -->
    <VBox prefWidth="620" prefHeight="720" spacing="0">
        <MediaView fx:id="bgMediaView" fitWidth="620" fitHeight="730" preserveRatio="false"/>
    </VBox>
</HBox>


