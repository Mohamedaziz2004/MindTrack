<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane prefWidth="1100" prefHeight="700"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ProfileController">

<!-- SIDEBAR (UNCHANGED) -->
<left>
    <VBox spacing="15" styleClass="sidebar" prefWidth="180">
        <children>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <children>
                    <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                        <image>
                            <Image url="@../logo.png"/>
                        </image>
                    </ImageView>
                    <Label styleClass="app-title" text="Mind Track"/>
                </children>
            </HBox>

            <Button text="Journal" styleClass="sidebar-button"/>
            <Button text="Goals" styleClass="sidebar-button"/>
            <Button text="Exercises" styleClass="sidebar-button"/>
            <Button text="Habits" styleClass="sidebar-button"/>
            <Button text="Profile" styleClass="sidebar-button-active"/>
            <Button text="Statistics" styleClass="sidebar-button"/>
            <Button text="Admin" styleClass="sidebar-button"/>
            <Button text="Settings" styleClass="sidebar-button"/>
            <Button text="Log Out" styleClass="sidebar-button"/>

        </children>
        <padding>
            <Insets top="20" left="15"/>
        </padding>
    </VBox>
</left>

<!-- MAIN CONTENT -->
<center>
    <ScrollPane fitToWidth="true" styleClass="main-scroll">
        <content>

            <VBox spacing="20" styleClass="main-content">

                <!-- TITLE -->
                <Label text="Psychological Profile Manager" styleClass="page-title"/>

                <!-- ================= PROFILE CARD ================= -->
                <VBox spacing="15" styleClass="card">

                    <Label text="Your Profile" styleClass="section-title"/>

                    <!-- EXISTING FIELDS (DO NOT CHANGE IDS) -->
                    <TextField fx:id="nomField" promptText="Last Name" styleClass="input"/>
                    <TextField fx:id="prenomField" promptText="First Name" styleClass="input"/>
                    <TextField fx:id="emailField" promptText="Email" styleClass="input"/>
                    <TextField fx:id="ageField" promptText="Age" styleClass="input"/>

                    <!-- PLACEHOLDER UI (NO fx:id) -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ImageView fitHeight="50" fitWidth="50"/>
                        <Button text="Upload New Picture" styleClass="secondary-button"/>
                    </HBox>

                    <TextArea promptText="About Me"
                              prefHeight="80"
                              styleClass="textarea"/>

                </VBox>

                <!-- ================= PSYCHOLOGICAL DATA (WORKING) ================= -->
                <VBox spacing="12" styleClass="card">

                    <Label text="Psychological Data" styleClass="section-title"/>

                    <!-- EXISTING FIELDS (DO NOT CHANGE IDS) -->
                    <TextField fx:id="stressField" promptText="Stress Level" styleClass="input"/>
                    <TextField fx:id="motivationField" promptText="Motivation Level" styleClass="input"/>
                    <TextArea fx:id="descriptionArea"
                              promptText="Description"
                              prefHeight="80"
                              styleClass="textarea"/>

                </VBox>

                <!-- ================= ASSESSMENTS (PLACEHOLDER) ================= -->
                <VBox spacing="12" styleClass="card">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Your Assessments" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Take New Assessment" styleClass="secondary-button"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox>
                            <Label text="Mindfulness &amp; Stress Resilience"/>
                            <Label text="Completed 2023-10-26" style="-fx-text-fill: #777; -fx-font-size: 11;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="View Report" styleClass="small-button"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox>
                            <Label text="Emotional Intelligence Profile"/>
                            <Label text="Pending 2024-01-15" style="-fx-text-fill: #777; -fx-font-size: 11;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Continue Assessment" styleClass="small-button"/>
                    </HBox>

                </VBox>

                <!-- ================= PREFERENCES (PLACEHOLDER) ================= -->
                <VBox spacing="12" styleClass="card">

                    <Label text="Application Preferences" styleClass="section-title"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Mood Tracking Frequency"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox/>
                    </HBox>

                    <CheckBox text="Receive daily prompts to write in your journal"/>
                    <CheckBox text="Get notified about your goal progress and milestones"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Display Theme"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox/>
                    </HBox>

                </VBox>

                <!-- ================= ACCOUNT & SECURITY ================= -->
                <VBox spacing="12" styleClass="card">

                    <Label text="Account &amp; Security" styleClass="section-title"/>

                    <!-- KEEP EXISTING DELETE LOGIC BUTTON -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Password"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Change Password" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Export Data"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Export My Data" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Delete Account"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Delete Account"
                                onAction="#handleDelete"
                                styleClass="danger-button"/>
                    </HBox>

                </VBox>

                <!-- ================= ACTION BUTTONS (WORKING) ================= -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Discard Changes" styleClass="secondary-button"/>
                    <Button text="Save Changes"
                            onAction="#handleUpdate"
                            styleClass="primary-button"/>
                </HBox>

                <Label fx:id="messageLabel" styleClass="message-label"/>

            </VBox>

        </content>
    </ScrollPane>
</center>

</BorderPane>