<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.RegisterController"
           prefWidth="1120" prefHeight="700">

    <!-- BACKGROUND IMAGE -->
    <ImageView fx:id="bgImageView" fitWidth="1366" fitHeight="768"
               preserveRatio="false" pickOnBounds="true">
        <image><Image url="@../RegisterBg.jpg"/></image>
    </ImageView>

    <!-- DARK OVERLAY -->
    <Pane style="-fx-background-color: rgba(0,0,0,0.4);"/>

    <!-- GLASS CARD -->
    <VBox alignment="CENTER" maxWidth="420" maxHeight="620"
          spacing="8" styleClass="glass-card">
        <padding><Insets topRightBottomLeft="22"/></padding>

        <!-- LOGO -->
        <HBox spacing="8" alignment="CENTER">
            <ImageView fitHeight="24" fitWidth="24" preserveRatio="true">
                <image><Image url="@../logo.png"/></image>
            </ImageView>
            <Label text="MindTrack" styleClass="glass-title"
                   style="-fx-font-size: 16px;"/>
        </HBox>

        <Label text="Create your account" styleClass="glass-title"
               style="-fx-font-size: 22px;"/>

        <Label text="Start your mental wellness journey today"
               styleClass="glass-subtitle" wrapText="true" textAlignment="CENTER"
               style="-fx-font-size: 12px;"/>

        <!-- LAST NAME -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Last Name" styleClass="glass-label"/>
            <TextField fx:id="nomField" promptText="Doe"
                       styleClass="glass-input" prefHeight="34"/>
            <Label fx:id="nomErrorLabel" text="" visible="false" managed="false"
                   styleClass="input-error-label"/>
        </VBox>

        <!-- FIRST NAME -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="First Name" styleClass="glass-label"/>
            <TextField fx:id="prenomField" promptText="John"
                       styleClass="glass-input" prefHeight="34"/>
            <Label fx:id="prenomErrorLabel" text="" visible="false" managed="false"
                   styleClass="input-error-label"/>
        </VBox>

        <!-- EMAIL -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Email" styleClass="glass-label"/>
            <TextField fx:id="emailField" promptText="you@example.com"
                       styleClass="glass-input" prefHeight="34"/>
            <Label fx:id="emailErrorLabel" text="" visible="false" managed="false"
                   styleClass="input-error-label"/>
        </VBox>

        <!-- PASSWORD -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Password" styleClass="glass-label"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"
                           styleClass="glass-input" prefHeight="34"/>
            <Label fx:id="passwordErrorLabel" text="" visible="false" managed="false"
                   styleClass="input-error-label"/>
        </VBox>

        <!-- AGE -->
        <VBox spacing="3" alignment="CENTER_LEFT">
            <Label text="Age" styleClass="glass-label"/>
            <TextField fx:id="ageField" promptText="25"
                       styleClass="glass-input" prefHeight="34"/>
            <Label fx:id="ageErrorLabel" text="" visible="false" managed="false"
                   styleClass="input-error-label"/>
        </VBox>

        <!-- FACE CAPTURE -->
        <Button text="Capture Face" onAction="#handleCaptureFace"
                maxWidth="Infinity" prefHeight="32"
                styleClass="outline-button"/>

        <!-- CREATE -->
        <Button text="Create Account" onAction="#handleRegister"
                maxWidth="Infinity" prefHeight="36"
                styleClass="accent-button"/>

        <!-- LOGIN LINK -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Already have an account?" styleClass="glass-subtitle"/>
            <Hyperlink text="Sign in" onAction="#openLogin"
                       styleClass="glass-link"/>
        </HBox>

        <!-- MESSAGE -->
        <Label fx:id="messageLabel" wrapText="true" textAlignment="CENTER"
               styleClass="glass-subtitle" style="-fx-font-size: 12px;"/>
    </VBox>
</StackPane>
