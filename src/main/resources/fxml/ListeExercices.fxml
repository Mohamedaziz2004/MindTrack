<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<BorderPane stylesheets="@mission-shell.css" prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #F2F4F7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListeExercicesController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #D1D9E6; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="MindTrack" />
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text=" Gestion des Exercices">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleRetour" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="← Retour">
                    <HBox.margin>
                        <Insets left="10.0" right="30.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="25.0" BorderPane.alignment="CENTER">
            <children>
                <!-- En-tête de la section -->
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="📋 Liste des Exercices">
                            <effect>
                                <DropShadow>
                                    <color>
                                        <Color red="0.8" green="0.8" blue="0.8" />
                                    </color>
                                </DropShadow>
                            </effect>
                        </Label>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Gérez votre bibliothèque d'exercices de bien-être mental" />
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </VBox>

                <!-- Barre de recherche et actions -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" prefWidth="300.0" promptText="Rechercher un exercice..." style="-fx-background-radius: 20; -fx-padding: 10 15; -fx-border-color: #e9ecef; -fx-border-radius: 20;">
                            <HBox.margin>
                                <Insets left="30.0" />
                            </HBox.margin>
                        </TextField>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalLabel" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Total: 0 exercices">
                            <HBox.margin>
                                <Insets right="30.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>

                <!-- Carte contenant le tableau -->
                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-border-color: #e9ecef; -fx-border-radius: 15;">
                    <children>
                        <!-- Boutons d'action -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="btnAjouter" mnemonicParsing="false" onAction="#handleAjouter" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="➕ Ajouter" />
                                <Button fx:id="btnModifier" mnemonicParsing="false" onAction="#handleModifier" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="✏ Modifier" />
                                <Button fx:id="btnSupprimer" mnemonicParsing="false" onAction="#handleSupprimer" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="🗑 Supprimer" />
                                <Button fx:id="btnDetails" mnemonicParsing="false" onAction="#handleDetails" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="📄 Détails" />
                            </children>
                        </HBox>

                        <!-- Tableau des exercices (ID column removed) -->
                        <TableView fx:id="tableView" prefHeight="350.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e9ecef;">
                            <columns>
                                <TableColumn fx:id="colNom" prefWidth="250.0" text="Nom" />
                                <TableColumn fx:id="colType" prefWidth="180.0" text="Type" />
                                <TableColumn fx:id="colDuree" prefWidth="120.0" text="Durée (min)" />
                                <TableColumn fx:id="colDifficulte" prefWidth="120.0" text="Difficulté" />
                                <TableColumn fx:id="colDemarche" prefWidth="200.0" text="Aperçu démarche" />
                                <TableColumn fx:id="colDescription" prefWidth="200.0" text="Description" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
            </padding>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="40.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-width: 1 0 0 0;">
            <children>
                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="© 2026 MindTrack - Votre compagnon de bien-être mental" />
            </children>
        </HBox>
    </bottom>
</BorderPane>