<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<BorderPane stylesheets="@mission-shell.css" prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #F2F4F7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListeSessionsController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #D1D9E6; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="MindTrack" />
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Gestion des Sessions">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleRetour" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="← Retour">
                    <HBox.margin>
                        <Insets left="10.0" right="30.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="25.0" BorderPane.alignment="CENTER">
            <children>
                <!-- En-tête de la section -->
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="⏱ Liste des Sessions">
                            <effect>
                                <DropShadow>
                                    <color>
                                        <Color red="0.8" green="0.8" blue="0.8" />
                                    </color>
                                </DropShadow>
                            </effect>
                        </Label>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Suivre et gérer les sessions d'entraînement" />
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </VBox>

                <!-- Filtres et actions -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <ComboBox fx:id="filterCombo" prefWidth="200.0" promptText="Filtrer par statut..." style="-fx-background-radius: 20; -fx-padding: 5 15; -fx-border-color: #e9ecef; -fx-border-radius: 20;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalLabel" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Total: 0 sessions">
                            <HBox.margin>
                                <Insets right="30.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets left="30.0" right="30.0" />
                    </VBox.margin>
                </HBox>

                <!-- Carte contenant le tableau -->
                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-border-color: #e9ecef; -fx-border-radius: 15;">
                    <children>
                        <!-- Boutons d'action -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="btnNouvelle" mnemonicParsing="false" onAction="#handleNouvelleSession" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="▶ Nouvelle session" />
                                <Button fx:id="btnDetails" mnemonicParsing="false" onAction="#handleDetails" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="📄 Détails" />
                                <Button fx:id="btnTerminer" mnemonicParsing="false" onAction="#handleTerminer" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="✅ Terminer" />
                            </children>
                        </HBox>

                        <!-- Tableau des sessions (ID column removed) -->
                        <TableView fx:id="tableView" prefHeight="350.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e9ecef;">
                            <columns>
                                <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
                                <TableColumn fx:id="colExercice" prefWidth="250.0" text="Exercice" />
                                <TableColumn fx:id="colStatut" prefWidth="120.0" text="Statut" />
                                <TableColumn fx:id="colResultat" prefWidth="200.0" text="Résultat" />
                                <TableColumn fx:id="colDuree" prefWidth="100.0" text="Durée (s)" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Barre de statistiques -->
                        <HBox fx:id="statsBar" alignment="CENTER" spacing="30.0" style="-fx-background-color: #F8F9F9; -fx-background-radius: 10; -fx-padding: 15;">
                            <children>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="En cours" />
                                        <Label fx:id="enCoursLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F39C12;" text="0" />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Terminées" />
                                        <Label fx:id="termineesLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="0" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
            </padding>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="40.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-width: 1 0 0 0;">
            <children>
                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="© 2026 MindTrack - Votre compagnon de bien-être mental" />
            </children>
        </HBox>
    </bottom>
</BorderPane>