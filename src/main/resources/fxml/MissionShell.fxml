<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MissionShellController"
            stylesheets="@mission-shell.css"
            styleClass="shell-root"
            prefWidth="1280"
            prefHeight="800">



    <!-- Left: Vertical Sidebar Navbar -->
    <left>
        <VBox fx:id="sidebar"
              styleClass="sidebar-animated"
              spacing="0"
              prefWidth="70"
              minWidth="70"
              maxWidth="70"
              onMouseEntered="#expandSidebar"
              onMouseExited="#collapseSidebar">

            <!-- Brand Section -->
            <VBox styleClass="brand-container" alignment="CENTER">
                <StackPane styleClass="brand-icon">
                    <ImageView fx:id="brandLogo" styleClass="brand-logo" fitWidth="36" fitHeight="36" preserveRatio="true"/>
                </StackPane>
                <Label styleClass="brand-text" text="MindTrack"/>
                <Label styleClass="brand-subtext" text="Bien-être mental"/>
            </VBox>

            <!-- Navigation Links -->
            <VBox styleClass="nav-container" alignment="CENTER" spacing="4">
                <Button fx:id="btnMenuPrincipal"
                        text="Accueil"
                        onAction="#showMenuPrincipal"
                        styleClass="nav-button"
                        maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="🏠" styleClass="nav-icon"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnExercices"
                        text="Exercices"
                        onAction="#showExercices"
                        styleClass="nav-button"
                        maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="🏋️" styleClass="nav-icon"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnSessions"
                        text="Sessions"
                        onAction="#showSessions"
                        styleClass="nav-button"
                        maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="⏱️" styleClass="nav-icon"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnTableauBord"
                        text="Tableau de bord"
                        onAction="#showTableauBord"
                        styleClass="nav-button"
                        maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📊" styleClass="nav-icon"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnStatistiques"
                        text="Statistiques"
                        onAction="#showStatistiques"
                        styleClass="nav-button"
                        maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📈" styleClass="nav-icon"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnHistorique"
                        text="Historique"
                        onAction="#showHistorique"
                        styleClass="nav-button"
                        maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📜" styleClass="nav-icon"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnTodo"
                        text="Todo List"
                        onAction="#showTodo"
                        styleClass="nav-button"
                        maxWidth="Infinity">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📋" styleClass="nav-icon"/>
                        </HBox>
                    </graphic>
                </Button>


            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Theme Toggle Button -->
            <Button fx:id="btnTheme" styleClass="theme-toggle" text="🌙" maxWidth="Infinity"/>

            <!-- User Section at Bottom -->
            <VBox styleClass="user-container" alignment="CENTER" spacing="12">
                <StackPane>
                    <Circle fx:id="userAvatar" radius="20" styleClass="user-avatar-glow"/>
                </StackPane>
                <Label fx:id="userName" text="Admin User" styleClass="user-name"/>
                <Label fx:id="userRole" text="Administrateur" styleClass="user-role"/>

                <!-- Logout Button -->
                <Button text="🚪" onAction="#logout" styleClass="logout-button" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center: Content Area -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>