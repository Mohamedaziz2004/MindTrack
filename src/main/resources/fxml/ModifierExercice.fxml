<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Point3D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@mission-shell.css" prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #F2F4F7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModifierExerciceController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #D1D9E6; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="MindTrack" />
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Modifier l'exercice">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleAnnuler" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Fermer">
                    <HBox.margin>
                        <Insets left="10.0" right="30.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <!-- En-tête de la section -->
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #F39C12;" text="✏ Modifier l'exercice">
                            <effect>
                                <DropShadow>
                                    <color>
                                        <Color red="0.8" green="0.8" blue="0.8" />
                                    </color>
                                </DropShadow>
                            </effect>
                        </Label>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Modifier les informations de l'exercice" />
                    </children>
                </VBox>

                <!-- Carte formulaire -->
                <VBox maxWidth="600.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-border-color: #e9ecef; -fx-border-radius: 15;">
                    <children>
                        <!-- ID (lecture seule) -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="ID" />
                                <TextField fx:id="txtId" editable="false" style="-fx-background-color: #F8F9F9; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                            </children>
                        </VBox>

                        <!-- Nom - Added errorNom label -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Nom de l'exercice *" />
                                <TextField fx:id="txtNom" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                <Label fx:id="errorNom" style="-fx-text-fill: #E74C3C; -fx-font-size: 11;" text=" " visible="false" />
                            </children>
                        </VBox>

                        <!-- Type - Changed to ComboBox with fx:id -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Type *" />
                                <ComboBox fx:id="comboType" prefWidth="250.0" promptText="Sélectionner un type" style="-fx-background-radius: 8; -fx-padding: 5; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                <Label fx:id="errorType" style="-fx-text-fill: #E74C3C; -fx-font-size: 11;" text=" " visible="false" />
                            </children>
                        </VBox>

                        <!-- Durée et Difficulté sur la même ligne -->
                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Durée (minutes) *" />
                                        <Spinner fx:id="spinnerDuree" prefWidth="200.0" style="-fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                        <Label fx:id="errorDuree" style="-fx-text-fill: #E74C3C; -fx-font-size: 11;" text=" " visible="false" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Difficulté *" />
                                        <ComboBox fx:id="comboDifficulte" editable="true" prefWidth="200.0" promptText="Sélectionner" style="-fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Description -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Description" />
                                <TextArea fx:id="txtDescription" prefRowCount="4" style="-fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="📋 Démarche / Instructions" />
                                <TextArea fx:id="txtDemarche" prefRowCount="6" style="-fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" wrapText="true" />
                            </children>
                        </VBox>

                        <!-- Dates -->
                        <HBox spacing="20.0">
                            <children>
                                <!-- Date de création (lecture seule) -->
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Date de création" />
                                        <DatePicker fx:id="dateCreationPicker" editable="false" style="-fx-background-color: #F8F9F9; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                    </children>
                                </VBox>
                                <!-- Date de modification -->
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Date de modification" />
                                        <DatePicker fx:id="dateModificationPicker" editable="false" style="-fx-background-color: #F8F9F9; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Champ requis -->
                        <Label style="-fx-text-fill: #7F8C8D; -fx-font-size: 11px;" text="* Champs requis" />
                    </children>
                </VBox>

                <!-- Boutons d'action -->
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnReset" mnemonicParsing="false" onAction="#handleReset" style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30; -fx-cursor: hand;" text="Réinitialiser" />
                        <Button fx:id="btnModifier" mnemonicParsing="false" onAction="#handleModifier" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 40; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(243,156,18,0.3), 10, 0, 0, 5);" text="✏️ Modifier" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="40.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-width: 1 0 0 0;">
            <children>
                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="© 2026 MindTrack - Votre compagnon de bien-être mental" />
            </children>
        </HBox>
    </bottom>
</BorderPane>