<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<BorderPane stylesheets="@mission-shell.css" prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #F2F4F7;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.TerminerSessionController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #D1D9E6; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="MindTrack" />
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Terminer la session">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleAnnuler" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Fermer">
                    <HBox.margin>
                        <Insets left="10.0" right="30.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <!-- En-tête de la section -->
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="✅Terminer la session">
                            <effect>
                                <DropShadow>
                                    <color>
                                        <Color red="0.8" green="0.8" blue="0.8" />
                                    </color>
                                </DropShadow>
                            </effect>
                     <padding>
                        <Insets top="-10.0" />
                     </padding>
                     <VBox.margin>
                        <Insets top="-5.0" />
                     </VBox.margin>
                        </Label>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Enregistrer les résultats de la session" />
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </VBox>

                <!-- Carte formulaire -->
                <VBox maxWidth="550.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-border-color: #e9ecef; -fx-border-radius: 15;">
                    <children>
                        <!-- Informations session -->
                        <VBox spacing="12.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-min-width: 120; -fx-text-fill: #2C3E50;" text="Session # :" />
                                        <Label fx:id="lblSessionId" style="-fx-text-fill: #3498DB; -fx-font-weight: bold;" text="-" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-min-width: 120; -fx-text-fill: #2C3E50;" text="Exercice :" />
                                        <Label fx:id="lblExerciceNom" style="-fx-text-fill: #7f8c8d;" text="-" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-min-width: 120; -fx-text-fill: #2C3E50;" text="Début :" />
                                        <Label fx:id="lblDateDebut" style="-fx-text-fill: #7f8c8d;" text="-" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-min-width: 120; -fx-text-fill: #2C3E50;" text="Durée prévue :" />
                                        <Label fx:id="lblDureePrevue" style="-fx-text-fill: #7f8c8d;" text="-" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Separator style="-fx-background-color: #e9ecef;" />

                        <!-- Résultat -->
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Résultat" />
                                <TextField fx:id="txtResultat" promptText="Ex: Exercice terminé avec succès" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                            </children>
                        </VBox>

                        <!-- Checkbox pour créer progression -->
                        <CheckBox fx:id="chkCreerProgression" selected="true" style="-fx-text-fill: #2C3E50;" text="Créer une progression" />

                        <!-- Zone progression (conditionnelle) -->
                        <VBox fx:id="progressionBox" spacing="12.0">
                            <children>
                                <VBox>
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Score (0-100)" />
                                        <Spinner fx:id="spinnerScore" editable="true" prefWidth="150.0" style="-fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                        <Label fx:id="errorScore" style="-fx-text-fill: #E74C3C; -fx-font-size: 11;" text=" " visible="false" />
                                    </children>
                                </VBox>

                                <VBox>
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Ressenti /Bien-être (1-10)" />
                                        <Spinner fx:id="spinnerRessenti" editable="true" prefWidth="150.0" style="-fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" />
                                        <Label fx:id="errorRessenti" style="-fx-text-fill: #E74C3C; -fx-font-size: 11;" text=" " visible="false" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Commentaires -->
                        <VBox spacing="8.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Commentaires" />
                                <TextArea fx:id="txtCommentaires" prefRowCount="3" promptText="Comment avez-vous vécu cette session ?" style="-fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
                </VBox>

                <!-- Boutons d'action -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="btnReset" mnemonicParsing="false" onAction="#handleReset" style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;" text="Réinitialiser" />
                        <Button fx:id="btnAide" mnemonicParsing="false" onAction="#handleAide" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;" text="Aide" />
                        <Button fx:id="btnTerminer" mnemonicParsing="false" onAction="#handleTerminer" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 35; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(39,174,96,0.3), 10, 0, 0, 5);" text="Terminer" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </HBox>
            </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="-10.0" />
         </padding>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="40.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-width: 1 0 0 0;">
            <children>
                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="© 2026 MindTrack - Votre compagnon de bien-être mental" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
