<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HabitudeController"
            fitToWidth="true"
            pannable="true"
            styleClass="scroll-pane">

    <content>
        <VBox spacing="16">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <!-- Header -->
            <VBox spacing="4">
                <Label text="Habit Tracker" styleClass="page-title"/>
                <Label text="Cultivate positive habits and track your progress. Mark your days to build powerful streaks!"
                       styleClass="page-subtitle"
                       wrapText="true"/>
            </VBox>

            <!-- Add New Habit Card -->
            <VBox spacing="12" styleClass="card">
                <Label text="Add New Habit" styleClass="card-title"/>

                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Habit Name" styleClass="field-label"/>
                        <TextField fx:id="tfNom" promptText="e.g. Meditate daily"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Frequency" styleClass="field-label"/>
                        <TextField fx:id="tfFrequence" promptText="e.g. Daily / 3x week"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Description (Optional)" styleClass="field-label"/>
                        <TextArea fx:id="tfObjectif"
                                  promptText="e.g. Focus on mindfulness for 10 minutes"
                                  prefRowCount="3"/>
                    </VBox>

                    <!-- Type + Target -->
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Type" styleClass="field-label"/>
                        <ComboBox fx:id="cbType" prefWidth="220"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Target &amp; Unit" styleClass="field-label"/>
                        <HBox spacing="10">
                            <Spinner fx:id="spTarget" prefWidth="110"/>
                            <TextField fx:id="tfUnit" promptText="unit (x/min)" prefWidth="160"/>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- Buttons row -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button text="＋ Add Habit" onAction="#ajouterHabitude"
                            styleClass="btn-primary"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>

                    <Button text="Edit Selected" onAction="#modifierHabitude" styleClass="btn-secondary"/>
                    <Button text="Delete Selected" onAction="#supprimerHabitude" styleClass="btn-danger"/>
                </HBox>

                <Label text="Tip: click a habit card to select it, then edit/delete." styleClass="hint"/>
            </VBox>
            <!-- Your Habits -->
            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Your Habits" styleClass="section-title"/>
                    <Pane HBox.hgrow="ALWAYS"/>

                    <!-- ✅ Search -->
                    <TextField fx:id="tfSearch"
                               promptText="Search habits..."
                               prefWidth="260"
                               styleClass="search-field"/>

                    <Label text="Sort:" styleClass="hint"/>
                    <ComboBox fx:id="cbSort" prefWidth="200"/>
                    <Button text="Export PDF" onAction="#exportPdf" styleClass="btn-secondary"/>
                    <Button text="Refresh" onAction="#loadHabitudes" styleClass="btn-outline btn-sm"/>
                </HBox>

                <FlowPane fx:id="cardsContainer"
                          hgap="14" vgap="14"
                          prefWrapLength="980"
                          styleClass="cards-grid"/>
            </VBox>

            <Label text="© 2026 Mind Track. All rights reserved." styleClass="footer"/>
        </VBox>
    </content>
</ScrollPane>