<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.RappelController"
      spacing="12">

    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="Rappels - Ajouter + Actifs + Activer/Désactiver"
           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    <HBox spacing="10">
        <Label text="Habitude:"/>
        <ComboBox fx:id="cbHabitudes" prefWidth="260"/>

        <Label text="Heure:"/>
        <Spinner fx:id="spH" prefWidth="80"/>
        <Label text=":"/>
        <Spinner fx:id="spM" prefWidth="80"/>

        <CheckBox fx:id="chkActif" text="Actif" selected="true"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Jours:"/>
        <CheckBox fx:id="jLun" text="Lun"/>
        <CheckBox fx:id="jMar" text="Mar"/>
        <CheckBox fx:id="jMer" text="Mer"/>
        <CheckBox fx:id="jJeu" text="Jeu"/>
        <CheckBox fx:id="jVen" text="Ven"/>
        <CheckBox fx:id="jSam" text="Sam"/>
        <CheckBox fx:id="jDim" text="Dim"/>
    </HBox>

    <TextField fx:id="tfMsg" promptText="Message du rappel"/>

    <HBox spacing="10">
        <Button text="Ajouter rappel" onAction="#ajouter"/>
        <Button text="Afficher actifs" onAction="#actifs"/>
        <Button text="Basculer Actif" onAction="#toggleActif"/>
        <Button text="Supprimer" onAction="#supprimer"/>
    </HBox>

    <TableView fx:id="tvRappels" prefHeight="450">
        <columns>
            <TableColumn fx:id="colHeure" text="Heure" prefWidth="120"/>
            <TableColumn fx:id="colJours" text="Jours" prefWidth="220"/>
            <TableColumn fx:id="colMsg" text="Message" prefWidth="350"/>
            <TableColumn fx:id="colActif" text="Actif" prefWidth="80"/>
        </columns>
    </TableView>

</VBox>
