<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.JalonProgressionViewController"
            minWidth="880" minHeight="560" prefWidth="1100" prefHeight="700"
            stylesheets="@styles.css"
            style="-fx-background-color: #f5f7fa;">

    <!-- Header removed from here to be integrated into scrollable content -->

    <!-- HEADER integrated into scrollable content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll" style="-fx-background-color: transparent;">
            <VBox spacing="0">
                <!-- INTEGRATED HEADER -->
                <VBox styleClass="header-scrollable">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button text="← Back" onAction="#handleBackToMenu" styleClass="nav-back-btn"
                               style="-fx-padding: 6 12; -fx-font-size: 11px; -fx-text-fill: white; -fx-font-weight: 800; -fx-cursor: hand; -fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 6;"/>
                        <Label text="Milestones &amp; Progress" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>

                <!-- 2-Column Main Content -->
                <HBox spacing="24" style="-fx-padding: 14 20 20 20;">
                    
                    <!-- LEFT COLUMN: Form -->
                    <VBox spacing="14" prefWidth="280" minWidth="240">
                        <VBox spacing="12" styleClass="dashboard-card-white">
                            <Label text="🎯 Set a Milestone" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            
                            <VBox spacing="6">
                                <Label text="Target Goal" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <ComboBox fx:id="objectifComboBox" 
                                         promptText="Choose a goal"
                                         prefWidth="Infinity"
                                         style="-fx-background-radius: 6; -fx-padding: 5;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Milestone Title" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <TextField fx:id="titleTextField" 
                                          promptText="e.g. Complete API Development"
                                          style="-fx-background-radius: 6; -fx-padding: 6;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Target Date" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <DatePicker fx:id="targetDatePicker" maxWidth="Infinity" style="-fx-background-radius: 6;"/>
                            </VBox>

                            <Button text="Add Milestone" fx:id="addMilestoneBtn" onAction="#handleAddMilestone" styleClass="btn-sky" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Stats Card -->
                        <VBox spacing="12" styleClass="dashboard-card-white">
                            <Label text="Overview" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            <HBox spacing="12">
                                <VBox spacing="2">
                                    <Label fx:id="totalMilestonesLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #4A9EEB;"/>
                                    <Label text="Total" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                </VBox>
                                <Separator orientation="VERTICAL"/>
                                <VBox spacing="2">
                                    <Label fx:id="completedMilestonesLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #10b981;"/>
                                    <Label text="Reached" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                </VBox>
                                <Separator orientation="VERTICAL"/>
                                <VBox spacing="2">
                                    <Label fx:id="remainingMilestonesLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #f39c12;"/>
                                    <Label text="Pending" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- RIGHT COLUMN: Milestone List -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Your Milestones" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="📄 PDF" onAction="#handleExportPDF" styleClass="btn-pdf"/>
                            <Button text="📊 CSV" onAction="#handleExportCSV" styleClass="btn-csv"/>
                        </HBox>

                        <!-- Search and Filter Bar -->
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="dashboard-card-white" style="-fx-padding: 6 10;">
                            <TextField fx:id="searchField" promptText="Search milestones..." HBox.hgrow="ALWAYS" 
                                       style="-fx-background-radius: 12; -fx-padding: 5 10; -fx-font-size: 12px;"/>
                            <ComboBox fx:id="reachedFilterCombo" promptText="Status" prefWidth="100"
                                      style="-fx-background-radius: 12;"/>
                        </HBox>
                        <VBox fx:id="milestonesContainerVBox" spacing="12">
                            <!-- Populated dynamically -->
                            <Label text="No milestones yet. Link one to a goal to get started!" 
                                   style="-fx-text-fill: #718096; -fx-font-style: italic; -fx-padding: 12; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Bottom bar removed as stats are now at the top -->

</BorderPane>
