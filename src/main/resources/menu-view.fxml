<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.MenuViewController"
            minWidth="880" minHeight="560" prefWidth="1100" prefHeight="700"
            stylesheets="@styles.css"
            style="-fx-background-color: #f5f7fa;">

    <!-- ===== PERSISTENT SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar">
            <!-- Logo Section -->
            <VBox styleClass="sidebar-logo-container" alignment="CENTER_LEFT" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                        <image>
                            <Image url="/logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="MindTrack" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #4A9EEB;"/>
                </HBox>
            </VBox>

            <!-- Main Nav -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <HBox fx:id="journalNavItem" styleClass="nav-item" alignment="CENTER_LEFT" onMouseClicked="#openDashboardView">
                    <Label text="📓" styleClass="nav-icon"/>
                    <Label text="Journal" styleClass="nav-label"/>
                </HBox>
                
                <HBox fx:id="goalsNavItem" styleClass="nav-item, nav-item-active" alignment="CENTER_LEFT" onMouseClicked="#openObjectifView">
                    <Label text="🎯" styleClass="nav-icon"/>
                    <Label text="Goals" styleClass="nav-label"/>
                </HBox>

                <HBox fx:id="exercisesNavItem" styleClass="nav-item" alignment="CENTER_LEFT">
                    <Label text="💪" styleClass="nav-icon"/>
                    <Label text="Exercises" styleClass="nav-label"/>
                </HBox>

                <HBox fx:id="habitsNavItem" styleClass="nav-item" alignment="CENTER_LEFT">
                    <Label text="🔄" styleClass="nav-icon"/>
                    <Label text="Habits" styleClass="nav-label"/>
                </HBox>

                <HBox fx:id="profileNavItem" styleClass="nav-item" alignment="CENTER_LEFT">
                    <Label text="👤" styleClass="nav-icon"/>
                    <Label text="Profile" styleClass="nav-label"/>
                </HBox>

                <HBox fx:id="statsNavItem" styleClass="nav-item" alignment="CENTER_LEFT" onMouseClicked="#openInsightsView">
                    <Label text="📊" styleClass="nav-icon"/>
                    <Label text="Statistics" styleClass="nav-label"/>
                </HBox>

                <HBox fx:id="adminNavItem" styleClass="nav-item" alignment="CENTER_LEFT">
                    <Label text="🛡️" styleClass="nav-icon"/>
                    <Label text="Admin" styleClass="nav-label"/>
                </HBox>

                <HBox fx:id="plannerNavItem" styleClass="nav-item" alignment="CENTER_LEFT" onMouseClicked="#openPlanificateurView">
                    <Label text="🧠" styleClass="nav-icon"/>
                    <Label text="Intelligent Planner" styleClass="nav-label"/>
                </HBox>
            </VBox>

            <!-- Footer Nav -->
            <VBox styleClass="sidebar-footer">
                <Separator style="-fx-opacity: 0.5;"/>
                <HBox styleClass="nav-item" alignment="CENTER_LEFT" onMouseClicked="#handleQuit">
                    <Label text="🚪" styleClass="nav-icon" style="-fx-text-fill: #e53e3e;"/>
                    <Label text="Log Out" styleClass="nav-label" style="-fx-text-fill: #e53e3e;"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT AREA ===== -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f8fafc;"/>
    </center>

    <!-- ===== BOTTOM FOOTER ===== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 8 16;">
            <Label text="© 2026 MindTrack" style="-fx-text-fill: #718096; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <Label text="•" style="-fx-text-fill: #a0aec0;"/>
            <Label text="Personal Objectives Management" style="-fx-text-fill: #718096; -fx-font-size: 10px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🚪 Quit" onAction="#handleQuit" styleClass="btn-primary" style="-fx-padding: 6 14; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>


</BorderPane>