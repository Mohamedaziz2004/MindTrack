<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.ObjectifViewController"
            minWidth="880" minHeight="560" prefWidth="1100" prefHeight="700"
            stylesheets="@styles.css"
            style="-fx-background-color: #f5f7fa;">

    <!-- Header removed from here to be integrated into scrollable content -->

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll" style="-fx-background-color: transparent;">
            <VBox spacing="0">
                <!-- INTEGRATED HEADER -->
                <VBox styleClass="header-scrollable">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button text="← Back" fx:id="backBtn" onAction="#handleBackToMenu" styleClass="nav-back-btn"
                               style="-fx-padding: 6 12; -fx-font-size: 11px; -fx-text-fill: white; -fx-font-weight: 800; -fx-cursor: hand; -fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 6;"/>
                        <Label text="Goals &amp; Tracking" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>

                <!-- PAGE CONTENT -->
                <VBox spacing="16" style="-fx-padding: 14 20 16 20;">
                    
                    <!-- TOP STATISTICS ROW -->
                    <HBox styleClass="stats-grid" alignment="CENTER_LEFT" spacing="12">
                        <HBox styleClass="stat-card-mini" alignment="CENTER_LEFT" spacing="10">
                            <StackPane styleClass="stat-icon-circle stat-icon-goals">
                                <Label text="📊" style="-fx-font-size: 14px;"/>
                            </StackPane>
                            <VBox>
                                <Label fx:id="totalGoalsLabel" text="0" styleClass="stat-value-mini"/>
                                <Label text="Total Goals" styleClass="stat-label-mini"/>
                            </VBox>
                        </HBox>
                        
                        <HBox styleClass="stat-card-mini" alignment="CENTER_LEFT" spacing="10">
                            <StackPane styleClass="stat-icon-circle stat-icon-miles">
                                <Label text="🚀" style="-fx-font-size: 14px;"/>
                            </StackPane>
                            <VBox>
                                <Label fx:id="activeGoalsLabel" text="0" styleClass="stat-value-mini"/>
                                <Label text="In Progress" styleClass="stat-label-mini"/>
                            </VBox>
                        </HBox>
                        
                        <HBox styleClass="stat-card-mini" alignment="CENTER_LEFT" spacing="10">
                            <StackPane styleClass="stat-icon-circle stat-icon-goals">
                                <Label text="✅" style="-fx-font-size: 14px;"/>
                            </StackPane>
                            <VBox>
                                <Label fx:id="completedGoalsLabel" text="0" styleClass="stat-value-mini"/>
                                <Label text="Completed" styleClass="stat-label-mini"/>
                            </VBox>
                        </HBox>
                    </HBox>

                    <HBox spacing="24" alignment="TOP_LEFT">

                <!-- LEFT PANEL: CREATE GOAL FORM - card container -->
                <VBox spacing="10" prefWidth="260" maxWidth="280" styleClass="form-card card"
                      style="-fx-background-radius: 12; -fx-padding: 12; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 14, 0, 0, 4);">
                    
                    <Label text="✨ Set a New Goal" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                    
                    <!-- Goal Title Input -->
                    <VBox spacing="5">
                        <Label text="Goal Title" styleClass="form-label"/>
                        <TextField fx:id="titleTextField" 
                                  promptText="e.g. Master JavaScript"/>
                    </VBox>

                    <!-- Description Input -->
                    <VBox spacing="5">
                        <Label text="Description" styleClass="form-label"/>
                        <TextArea fx:id="descriptionTextArea" 
                                 promptText="Describe your goal..."
                                 prefRowCount="3"
                                 wrapText="true"/>
                    </VBox>

                    <!-- Start Date -->
                    <VBox spacing="5">
                        <Label text="Start Date" styleClass="form-label"/>
                        <DatePicker fx:id="startDatePicker" maxWidth="Infinity"/>
                    </VBox>

                    <!-- End Date -->
                    <VBox spacing="5">
                        <Label text="Due Date" styleClass="form-label"/>
                        <DatePicker fx:id="endDatePicker" maxWidth="Infinity"/>
                    </VBox>

                    <!-- Create Button -->
                    <Button text="Create Goal ▶" 
                           fx:id="createButtonObjectif"
                           onAction="#handleCreateObjectif"
                            style="-fx-padding: 8px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: linear-gradient(to right, #87CEEB, #4A9EEB); -fx-background-radius: 6; -fx-cursor: hand;"
                           prefWidth="Infinity"/>

                </VBox>

                <!-- RIGHT PANEL: GOALS LIST - fills space and scrolls -->
                <VBox spacing="12" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Your Active Goals" styleClass="section-title"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📄 PDF" onAction="#handleExportPDF" styleClass="btn-pdf"/>
                        <Button text="📊 CSV" onAction="#handleExportCSV" styleClass="btn-csv"/>
                    </HBox>

                    <!-- Search and Filter Bar -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="dashboard-card-white" style="-fx-padding: 6 12;">
                        <TextField fx:id="searchField" promptText="Search goals..." HBox.hgrow="ALWAYS" 
                                   style="-fx-background-radius: 12; -fx-padding: 5 10; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="statusFilterCombo" promptText="Status" prefWidth="110"
                                  style="-fx-background-radius: 12;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="list-scroll"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-min-height: 180;">
                        <VBox fx:id="objectifsListContainer" spacing="10" style="-fx-padding: 6;"/>
                    </ScrollPane>

                    <!-- ACHIEVEMENTS SECTION - card row -->
                    <VBox spacing="8">
                        <Label text="Achievements" styleClass="section-title" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <VBox alignment="CENTER" spacing="4" styleClass="achievement-badge">
                                <Label text="🎯" style="-fx-font-size: 22px;"/>
                                <Label text="Goal Setter" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Jan 15, 2025" style="-fx-font-size: 9px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" styleClass="achievement-badge">
                                <Label text="🏆" style="-fx-font-size: 22px;"/>
                                <Label text="Pathway Hero" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Oct 15, 2024" style="-fx-font-size: 9px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" styleClass="achievement-badge">
                                <Label text="⚡" style="-fx-font-size: 22px;"/>
                                <Label text="Progress Pro" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Jan 5, 2025" style="-fx-font-size: 9px; -fx-text-fill: #718096;"/>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" styleClass="achievement-badge">
                                <Label text="📚" style="-fx-font-size: 22px;"/>
                                <Label text="Mindfulness Master" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Jun 25, 2024" style="-fx-font-size: 9px; -fx-text-fill: #718096;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- MOTIVATIONAL QUOTE - card -->
                    <VBox alignment="CENTER" spacing="6" styleClass="quote-box"
                          style="-fx-background-radius: 12; -fx-padding: 14;">
                        <Label text="💡" style="-fx-font-size: 24px;"/>
                        <Label wrapText="true" text="Every step forward, no matter how small, brings you closer to your ultimate self."
                               style="-fx-font-size: 12px; -fx-font-style: italic; -fx-text-fill: white; -fx-text-alignment: center;"/>
                    </VBox>

                </VBox>

                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Bottom bar removed as stats are now at the top -->

</BorderPane>
