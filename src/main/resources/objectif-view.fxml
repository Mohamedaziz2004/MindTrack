<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.ObjectifViewController"
            prefWidth="1400" prefHeight="900"
            stylesheets="@styles.css"
            style="-fx-background-color: #f5f7fa;">

    <!-- ===== TOP GRADIENT HEADER ===== -->
    <top>
        <VBox spacing="0" style="-fx-background: linear-gradient(to right, #00d2ff 0%, #3a7bd5 100%); -fx-padding: 20 40;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="←" fx:id="backBtn" 
                       style="-fx-padding: 8px 12px; -fx-font-size: 14px; -fx-background: linear-gradient(to right, #00d2ff, #3a7bd5); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 5;"/>
                <Label text="Goals &amp; Tracking" 
       style="-fx-font-size: 30px; 
              -fx-font-weight: bold; 
              -fx-text-fill: #4A9EEB;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f7fa;  -fx-background: #f5f7fa;">
            <HBox spacing="35" alignment="TOP_LEFT" style="-fx-padding: 40;">

                <!-- LEFT PANEL: CREATE GOAL FORM -->
                <VBox spacing="18" prefWidth="360"
                      style="-fx-border-radius: 15; -fx-padding: 30; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 8);">
                    
                    <Label text="✨ Set a New Goal" 
                           style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                    
                    <!-- Goal Title Input -->
                    <VBox spacing="7">
                        <Label text="Goal Title" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #00d2ff;"/>
                        <TextField fx:id="titleTextField" 
                                  promptText="e.g. Master JavaScript"
                                  style="-fx-padding: 12px 14px; -fx-border-radius: 8; -fx-font-size: 13px; -fx-border-color: #e8ecf1; -fx-border-width: 2; -fx-background-color: #fafbfc; -fx-text-fill: #4A9EEB;"/>
                    </VBox>

                    <!-- Description Input -->
                    <VBox spacing="7">
                        <Label text="Description" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #00d2ff;"/>
                        <TextArea fx:id="descriptionTextArea" 
                                 promptText="Describe your goal and why it matters..."
                                 prefRowCount="4"
                                 wrapText="true"
                                 style="-fx-padding: 12px 14px; -fx-border-radius: 8; -fx-font-size: 12px; -fx-border-color: #e8ecf1; -fx-border-width: 2; -fx-text-fill: #34495e; -fx-background-color: #fafbfc;"/>
                    </VBox>

                    <!-- Start Date -->
                    <VBox spacing="7">
                        <Label text="Start Date" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #00d2ff;"/>
                        <DatePicker fx:id="startDatePicker" 
                                   style="-fx-padding: 12px 14px; -fx-border-radius: 8; -fx-font-size: 12px; -fx-border-color: #e8ecf1; -fx-border-width: 2; -fx-text-fill: #4A9EEB;"/>
                    </VBox>

                    <!-- End Date -->
                    <VBox spacing="7">
                        <Label text="Due Date" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #00d2ff;"/>
                        <DatePicker fx:id="endDatePicker" 
                                   style="-fx-padding: 12px 14px; -fx-border-radius: 8; -fx-font-size: 12px; -fx-border-color: #e8ecf1; -fx-border-width: 2; -fx-text-fill: #4A9EEB;"/>
                    </VBox>

                    <!-- Create Button -->
                    <Button text="Create Goal ▶" 
                           fx:id="createButtonObjectif"
                           style="-fx-padding: 13px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background: linear-gradient(to right, #00d2ff, #3a7bd5); -fx-border-radius: 8; -fx-cursor: hand;"
                           prefWidth="Infinity"/>

                </VBox>

                <!-- RIGHT PANEL: GOALS LIST AND EXTRAS -->
                <VBox spacing="25" prefWidth="900" alignment="TOP_LEFT">
                    
                    <Label text="Your Active Goals" 
                           style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                    
                    <!-- Goals Container with Nice Scroll -->
                    <ScrollPane fitToWidth="true" prefHeight="320"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <VBox fx:id="goalsContainerVBox" spacing="14" style="-fx-padding: 5;"/>
                    </ScrollPane>

                    <!-- ACHIEVEMENTS SECTION -->
                    <VBox spacing="12">
                        <Label text="Achievements" 
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                        
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <!-- Goal Setter Badge -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-padding: 15; -fx-background-color: white; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                                <Label text="🎯" style="-fx-font-size: 36px;"/>
                                <Label text="Goal Setter" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Jan 15, 2025" style="-fx-font-size: 9px; -fx-text-fill: #95a5a6;"/>
                            </VBox>
                            
                            <!-- Pathway Hero Badge -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-padding: 15; -fx-background-color: white; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                                <Label text="🏆" style="-fx-font-size: 36px;"/>
                                <Label text="Pathway Hero" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Oct 15, 2024" style="-fx-font-size: 9px; -fx-text-fill: #95a5a6;"/>
                            </VBox>
                            
                            <!-- Progress Pro Badge -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-padding: 15; -fx-background-color: white; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                                <Label text="⚡" style="-fx-font-size: 36px;"/>
                                <Label text="Progress Pro" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Jan 5, 2025" style="-fx-font-size: 9px; -fx-text-fill: #95a5a6;"/>
                            </VBox>
                            
                            <!-- Mindfulness Master Badge -->
                            <VBox alignment="CENTER" spacing="8" 
                                  style="-fx-padding: 15; -fx-background-color: white; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                                <Label text="📚" style="-fx-font-size: 36px;"/>
                                <Label text="Mindfulness Master" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                                <Label text="Jun 25, 2024" style="-fx-font-size: 9px; -fx-text-fill: #95a5a6;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- MOTIVATIONAL QUOTE SECTION -->
                    <VBox alignment="CENTER" spacing="12" 
                          style="-fx-background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%); -fx-padding: 30; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
                        <Label text="💡" style="-fx-font-size: 42px;"/>
                        <Label text="Every step forward, no matter how small, brings you closer to your ultimate self." 
       style="-fx-font-size: 16px; 
              -fx-font-style: italic; 
              -fx-text-fill: #4A9EEB; 
              -fx-text-alignment: center; 
              -fx-wrap-text: true;"
       wrapText="true" 
       alignment="CENTER"/>
                    </VBox>

                </VBox>

            </HBox>
        </ScrollPane>
    </center>

    <!-- ===== BOTTOM STATISTICS ===== -->
    <bottom>
        <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #e8ecf1; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="25" bottom="25" left="40" right="40"/>
            </padding>
            
            <HBox alignment="CENTER" spacing="100">
                <VBox alignment="CENTER" spacing="8">
                    <Label text="📊" style="-fx-font-size: 32px;"/>
                    <Label fx:id="totalGoalsLabel" text="0" 
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #00d2ff;"/>
                    <Label text="Total Goals" 
                           style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
                </VBox>
                
                <Separator orientation="VERTICAL" prefHeight="60"/>
                
                <VBox alignment="CENTER" spacing="8">
                    <Label text="🚀" style="-fx-font-size: 32px;"/>
                    <Label fx:id="activeGoalsLabel" text="0" 
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                    <Label text="In Progress" 
                           style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
                </VBox>
                
                <Separator orientation="VERTICAL" prefHeight="60"/>
                
                <VBox alignment="CENTER" spacing="8">
                    <Label text="✅" style="-fx-font-size: 32px;"/>
                    <Label fx:id="completedGoalsLabel" text="0" 
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    <Label text="Completed" 
                           style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>
