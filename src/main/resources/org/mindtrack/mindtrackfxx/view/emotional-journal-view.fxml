<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.mindtrack.mindtrackfxx.controller.EmotionalJournalController"
            stylesheets="@../styles/styles.css"
            styleClass="root">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="240" styleClass="sidebar">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <!-- App Logo & Name in Sidebar -->
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="sidebar-header">
                <padding><Insets top="8" right="8" bottom="20" left="8"/></padding>
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                    <Image url="@../images/logo.png"/>
                </ImageView>
                <Label text="Mind Track" styleClass="sidebar-brand"/>
            </HBox>

            <!-- Main Navigation with custom icons -->
            <Button styleClass="nav-button, active" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <Image url="@../icons/journal.png"/>
                    </ImageView>
                </graphic>
                <text>Journal</text>
            </Button>
            <Button styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <Image url="@../icons/goal.png"/>
                    </ImageView>
                </graphic>
                <text>Goals</text>
            </Button>
            <Button styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <Image url="@../icons/exercice.png"/>
                    </ImageView>
                </graphic>
                <text>Exercises</text>
            </Button>
            <Button styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <Image url="@../icons/habits.png"/>
                    </ImageView>
                </graphic>
                <text>Habits</text>
            </Button>
            <Button styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <Image url="@../icons/profile.png"/>
                    </ImageView>
                </graphic>
                <text>Profile</text>
            </Button>
            <Button styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                        <Image url="@../icons/admin.png"/>
                    </ImageView>
                </graphic>
                <text>Admin</text>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Settings Section -->
            <Separator styleClass="sidebar-separator"/>
            <VBox spacing="4">
                <padding><Insets top="12"/></padding>
                <Button styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                            <Image url="@../icons/settings.png"/>
                        </ImageView>
                    </graphic>
                    <text>Settings</text>
                </Button>
                <Button styleClass="nav-button, danger" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                            <Image url="@../icons/logout.png"/>
                        </ImageView>
                    </graphic>
                    <text>Log Out</text>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="32" bottom="14" left="28"/></padding>

            <!-- Logo and Brand -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ImageView fitWidth="40" fitHeight="40" preserveRatio="true" styleClass="logo-image">
                    <Image url="@../images/logo.png"/>
                </ImageView>
                <Label text="Mind Track" styleClass="brand"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Avatar with initials -->
            <StackPane styleClass="avatar-container">
                <Circle radius="22" styleClass="avatar-circle"/>
                <Label text="U" styleClass="avatar-text"/>
            </StackPane>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll" hbarPolicy="NEVER">
            <VBox styleClass="content">
                <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>

                <!-- Page Title with icon -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                        <Image url="@../icons/journal.png"/>
                    </ImageView>
                    <Label text="Emotional Journal" styleClass="page-title"/>
                </HBox>

                <!-- TWO COLUMN LAYOUT FOR JOURNAL AND MOOD -->
                <HBox spacing="24">

                    <!-- SECTION 1: JOURNAL ENTRY -->
                    <VBox spacing="20" styleClass="section" HBox.hgrow="ALWAYS">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                                <Image url="@../icons/edit.png"/>
                            </ImageView>
                            <Label text="New Journal Entry" styleClass="section-title"/>
                        </HBox>

                        <!-- Date/Time Display -->
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="datetime-box">
                            <Label text="📅" style="-fx-font-size: 18px;"/>
                            <Label fx:id="currentDateTimeLabel" text="February 16, 2026 - 10:30 PM" styleClass="datetime-label"/>
                        </HBox>

                        <!-- Text Area -->
                        <TextArea fx:id="entryTextArea"
                                  promptText="What's on your mind today? Write down your thoughts and feelings here..."
                                  prefRowCount="6"
                                  wrapText="true"
                                  styleClass="entry-textarea"/>

                        <!-- Save Journal and AI Analyse Buttons -->
                        <HBox spacing="12">
                            <Button fx:id="saveEntryButton" onAction="#onSaveEntry" styleClass="btn, btn-primary">
                                <graphic>
                                    <HBox spacing="8" alignment="CENTER">
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                            <Image url="@../icons/save.png"/>
                                        </ImageView>
                                        <Label text="Save Journal" styleClass="btn-label"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="analyseButton" onAction="#onAnalyseEntry" styleClass="btn, btn-ai">
                                <graphic>
                                    <HBox spacing="8" alignment="CENTER">
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                            <Image url="@../icons/analysing.png"/>
                                        </ImageView>
                                        <Label text="AI Analyse" styleClass="btn-label"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <!-- SECTION 2: MOOD/HUMEUR -->
                    <VBox spacing="20" styleClass="section" prefWidth="380">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                                <Image url="@../emojis/happy.png"/>
                            </ImageView>
                            <Label text="How are you feeling?" styleClass="section-title"/>
                        </HBox>

                        <!-- Mood Selection with Custom Emojis -->
                        <VBox spacing="12">
                            <Label text="Select your mood:" styleClass="label-muted"/>

                            <fx:define>
                                <ToggleGroup fx:id="moodGroup"/>
                            </fx:define>

                            <VBox spacing="8" styleClass="mood-selection">
                                <RadioButton fx:id="moodHappy" toggleGroup="$moodGroup" styleClass="mood-radio, mood-happy">
                                    <graphic>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                                <Image url="@../emojis/happy.png"/>
                                            </ImageView>
                                            <Label text="Happy" styleClass="mood-label-large"/>
                                        </HBox>
                                    </graphic>
                                </RadioButton>
                                <RadioButton fx:id="moodCalm" toggleGroup="$moodGroup" styleClass="mood-radio, mood-calm">
                                    <graphic>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                                <Image url="@../emojis/calm.png"/>
                                            </ImageView>
                                            <Label text="Calm" styleClass="mood-label-large"/>
                                        </HBox>
                                    </graphic>
                                </RadioButton>
                                <RadioButton fx:id="moodNeutral" toggleGroup="$moodGroup" styleClass="mood-radio, mood-neutral">
                                    <graphic>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                                <Image url="@../emojis/neutral.png"/>
                                            </ImageView>
                                            <Label text="Neutral" styleClass="mood-label-large"/>
                                        </HBox>
                                    </graphic>
                                </RadioButton>
                                <RadioButton fx:id="moodSad" toggleGroup="$moodGroup" styleClass="mood-radio, mood-sad">
                                    <graphic>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                                <Image url="@../emojis/sad.png"/>
                                            </ImageView>
                                            <Label text="Sad" styleClass="mood-label-large"/>
                                        </HBox>
                                    </graphic>
                                </RadioButton>
                                <RadioButton fx:id="moodAnxious" toggleGroup="$moodGroup" styleClass="mood-radio, mood-anxious">
                                    <graphic>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                                                <Image url="@../emojis/anxious.png"/>
                                            </ImageView>
                                            <Label text="Anxious" styleClass="mood-label-large"/>
                                        </HBox>
                                    </graphic>
                                </RadioButton>
                            </VBox>
                        </VBox>

                        <!-- Intensity Slider -->
                        <VBox spacing="10">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Intensity:" styleClass="label-muted"/>
                                <Label fx:id="intensityValueLabel" text="5" styleClass="intensity-value"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER">
                                <Label text="1" styleClass="intensity-min"/>
                                <Slider fx:id="intensitySlider" min="1" max="10" value="5"
                                        showTickLabels="true" showTickMarks="true"
                                        majorTickUnit="1" minorTickCount="0" snapToTicks="true"
                                        blockIncrement="1" styleClass="intensity-slider"
                                        HBox.hgrow="ALWAYS"/>
                                <Label text="10" styleClass="intensity-max"/>
                            </HBox>
                        </VBox>

                        <!-- Save Mood and Statistics Buttons -->
                        <HBox spacing="12">
                            <Button fx:id="saveMoodButton" onAction="#onSaveMood" styleClass="btn, btn-mood">
                                <graphic>
                                    <HBox spacing="8" alignment="CENTER">
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                            <Image url="@../icons/save.png"/>
                                        </ImageView>
                                        <Label text="Save Mood" styleClass="btn-label"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="statisticsButton" onAction="#onShowStatistics" styleClass="btn, btn-stats">
                                <graphic>
                                    <HBox spacing="8" alignment="CENTER">
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                            <Image url="@../icons/statistics.png"/>
                                        </ImageView>
                                        <Label text="Statistics" styleClass="btn-label-dark"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- RECENT JOURNAL ENTRIES SECTION -->
                <VBox spacing="20">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                            <Image url="@../icons/journal.png"/>
                        </ImageView>
                        <Label text="Recent Journal Entries" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="showMoreJournalsBtn" onAction="#onShowMoreJournals" styleClass="btn, btn-show-more">
                            <graphic>
                                <HBox spacing="6" alignment="CENTER">
                                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                        <Image url="@../icons/show-more.png"/>
                                    </ImageView>
                                    <Label text="Show More" styleClass="show-more-label"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                    <FlowPane fx:id="entriesContainer" hgap="20" vgap="20" prefWrapLength="900"/>
                </VBox>

                <!-- RECENT MOOD ENTRIES SECTION -->
                <VBox spacing="20">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                            <Image url="@../emojis/happy.png"/>
                        </ImageView>
                        <Label text="Recent Mood Entries" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="showMoreMoodsBtn" onAction="#onShowMoreMoods" styleClass="btn, btn-show-more">
                            <graphic>
                                <HBox spacing="6" alignment="CENTER">
                                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                        <Image url="@../icons/show-more.png"/>
                                    </ImageView>
                                    <Label text="Show More" styleClass="show-more-label"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                    <FlowPane fx:id="moodEntriesContainer" hgap="20" vgap="20" prefWrapLength="900"/>
                </VBox>

                <!-- Footer -->
                <HBox alignment="CENTER" styleClass="footer">
                    <Label text="© 2026 Mind Track. All rights reserved." styleClass="small-muted"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
