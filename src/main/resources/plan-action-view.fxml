<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.PlanActionViewController"
            minWidth="880" minHeight="560" prefWidth="1100" prefHeight="700"
            stylesheets="@styles.css"
            style="-fx-background-color: #f5f7fa;">

    <!-- Header removed from here to be integrated into scrollable content -->

    <!-- HEADER integrated into scrollable content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll" style="-fx-background-color: transparent;">
            <VBox spacing="0">
                <!-- INTEGRATED HEADER -->
                <VBox styleClass="header-scrollable">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button text="← Back" onAction="#handleBackToMenu" styleClass="nav-back-btn"
                               style="-fx-padding: 6 12; -fx-font-size: 11px; -fx-text-fill: white; -fx-font-weight: 800; -fx-cursor: hand; -fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 6;"/>
                        <Label text="Action Plans" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>

                <!-- 2-Column Main Content -->
                <HBox spacing="24" style="-fx-padding: 14 20 20 20;">
                    
                    <!-- LEFT COLUMN: Form -->
                    <VBox spacing="14" prefWidth="280" minWidth="240">
                        <VBox spacing="12" styleClass="dashboard-card-white">
                            <Label text="⚡ Create Action Step" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            
                            <VBox spacing="6">
                                <Label text="Target Goal" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <ComboBox fx:id="objectifComboBox" 
                                         promptText="Choose a goal"
                                         prefWidth="Infinity"
                                         style="-fx-background-radius: 6; -fx-padding: 5;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Step Description" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <TextArea fx:id="descriptionTextArea" 
                                         promptText="Describe the action step..."
                                         prefRowCount="3"
                                         wrapText="true"
                                         style="-fx-background-radius: 6; -fx-padding: 6;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Priority Level" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <ComboBox fx:id="priorityComboBox" 
                                         promptText="Select priority"
                                         prefWidth="Infinity"
                                         style="-fx-background-radius: 6; -fx-padding: 5;"/>
                            </VBox>

                            <Button text="Add Action Step" fx:id="createActionBtn" onAction="#handleCreateActionPlan" styleClass="btn-sky" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Stats Card -->
                        <VBox spacing="12" styleClass="dashboard-card-white">
                            <Label text="Priority Analytics" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            <HBox spacing="10">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label fx:id="highPriorityLabel" text="0" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #e53e3e;"/>
                                    <Label text="High" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8;"/>
                                </VBox>
                                <Separator orientation="VERTICAL"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label fx:id="mediumPriorityLabel" text="0" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #f39c12;"/>
                                    <Label text="Medium" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8;"/>
                                </VBox>
                                <Separator orientation="VERTICAL"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label fx:id="totalActionsLabel" text="0" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #4A9EEB;"/>
                                    <Label text="Total" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- RIGHT COLUMN: Actions List -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Your Action Steps" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="📄 PDF" onAction="#handleExportPDF" styleClass="btn-pdf"/>
                            <Button text="📊 CSV" onAction="#handleExportCSV" styleClass="btn-csv"/>
                        </HBox>

                        <!-- Search and Filter Bar -->
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="dashboard-card-white" style="-fx-padding: 6 10;">
                            <TextField fx:id="searchField" promptText="Search steps..." HBox.hgrow="ALWAYS" 
                                       style="-fx-background-radius: 12; -fx-padding: 5 10; -fx-font-size: 12px;"/>
                            <ComboBox fx:id="priorityFilterCombo" promptText="Priority" prefWidth="100"
                                      style="-fx-background-radius: 12;"/>
                        </HBox>
                        
                        <VBox fx:id="actionsContainerVBox" spacing="12">
                            <!-- Populated dynamically -->
                            <Label text="Break your goals down into manageable steps!" 
                                   style="-fx-text-fill: #718096; -fx-font-style: italic; -fx-padding: 12; -fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Bottom bar removed as stats are now at the top -->

</BorderPane>
