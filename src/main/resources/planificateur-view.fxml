<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.PlanificateurIntelligentViewController"
            prefWidth="1400" prefHeight="900"
            stylesheets="@styles.css"
            style="-fx-background-color: #f5f7fa;">

    <!-- ===== TOP GRADIENT HEADER ===== -->
    <top>
        <VBox spacing="0" style="-fx-background: linear-gradient(to right, #00d2ff 0%, #3a7bd5 100%); -fx-padding: 40;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="←" fx:id="backBtn" 
                       style="-fx-padding: 8px 12px; -fx-font-size: 14px; -fx-background: linear-gradient(to right, #00d2ff, #3a7bd5); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 5;"/>
                <VBox spacing="5">
                    <Label text="⚙️ Intelligent Planner Settings" style="-fx-font-size: 30px; 
              -fx-font-weight: bold; 
              -fx-text-fill: #4A9EEB;"/>
                    <Label text="Coming Soon - Optimize your workflow and daily capacity" 
                           style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f7fa;">
            <VBox spacing="30" style="-fx-padding: 50 60;">
                
                <!-- Information Card -->
                <VBox spacing="18" 
                      style="-fx-padding: 30; -fx-border-radius: 15; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 8); -fx-border-left: 5px solid #e74c3c;">
                    
                    <Label text="🚀 Feature Under Development" 
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                    
                    <Label text="The Intelligent Planner is currently being developed. This powerful module will allow you to automatically organize your action steps based on priority or progression, adjust your daily capacity, and optimize your planning strategy with intelligent recommendations."
                           style="-fx-font-size: 13px; -fx-text-fill: #555555; -fx-wrap-text: true; -fx-line-spacing: 1.5;"
                           wrapText="true"/>
                </VBox>

                <!-- Coming Features -->
                <VBox spacing="15">
                    <Label text="✨ Planned Features" 
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                    
                    <HBox spacing="18">
                        <VBox spacing="12" prefWidth="280"
                              style="-fx-padding: 25; -fx-border-radius: 12; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                            <Label text="🎯" style="-fx-font-size: 36px;"/>
                            <Label text="Smart Prioritization" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            <Label text="Auto-organize action steps by priority level, importance, and deadlines" 
                                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-wrap-text: true;"
                                   wrapText="true"/>
                        </VBox>
                        
                        <VBox spacing="12" prefWidth="280"
                              style="-fx-padding: 25; -fx-border-radius: 12; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                            <Label text="⚡" style="-fx-font-size: 36px;"/>
                            <Label text="Daily Capacity" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            <Label text="Set your daily action capacity and let the system distribute tasks accordingly" 
                                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-wrap-text: true;"
                                   wrapText="true"/>
                        </VBox>
                        
                        <VBox spacing="12" prefWidth="280"
                              style="-fx-padding: 25; -fx-border-radius: 12; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                            <Label text="📊" style="-fx-font-size: 36px;"/>
                            <Label text="Progress Tracking" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            <Label text="Monitor real-time progress and get intelligent adjustment recommendations" 
                                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-wrap-text: true;"
                                   wrapText="true"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Use Other Modules -->
                <VBox spacing="15">
                    <Label text="💡 Start Here - Use These Features" 
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                    
                    <HBox spacing="20">
                        <VBox spacing="12" prefWidth="300"
                              onMouseClicked="#goToObjectif"
                              style="-fx-padding: 25; -fx-border-radius: 12; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-cursor: hand; -fx-border-left: 5px solid #00d2ff;">
                            <Label text="🎯" style="-fx-font-size: 40px;"/>
                            <Label text="Create Goals" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00d2ff;"/>
                            <Label text="Start by defining your personal goals with clear deadlines and descriptions" 
                                   style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-wrap-text: true; -fx-line-spacing: 1.2;"
                                   wrapText="true"/>
                            <Button text="Open Goals ▶" style="-fx-padding: 10px 16px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background: linear-gradient(to right, #00d2ff, #3a7bd5); -fx-border-radius: 6; -fx-cursor: hand;"/>
                        </VBox>
                        
                        <VBox spacing="12" prefWidth="300"
                              onMouseClicked="#goToMilestones"
                              style="-fx-padding: 25; -fx-border-radius: 12; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-cursor: hand; -fx-border-left: 5px solid #3a7bd5;">
                            <Label text="📍" style="-fx-font-size: 40px;"/>
                            <Label text="Set Milestones" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3a7bd5;"/>
                            <Label text="Break down each goal into meaningful milestones to track progress" 
                                   style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-wrap-text: true; -fx-line-spacing: 1.2;"
                                   wrapText="true"/>
                            <Button text="Open Milestones ▶" style="-fx-padding: 10px 16px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background: linear-gradient(to right, #00d2ff, #3a7bd5); -fx-border-radius: 6; -fx-cursor: hand;"/>
                        </VBox>
                        
                        <VBox spacing="12" prefWidth="300"
                              onMouseClicked="#goToActions"
                              style="-fx-padding: 25; -fx-border-radius: 12; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-cursor: hand; -fx-border-left: 5px solid #f39c12;">
                            <Label text="⚡" style="-fx-font-size: 40px;"/>
                            <Label text="Plan Actions" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                            <Label text="Define specific action steps with priorities to achieve your goals" 
                                   style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-wrap-text: true; -fx-line-spacing: 1.2;"
                                   wrapText="true"/>
                            <Button text="Open Actions ▶" style="-fx-padding: 10px 16px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background: linear-gradient(to right, #00d2ff, #3a7bd5); -fx-border-radius: 6; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
