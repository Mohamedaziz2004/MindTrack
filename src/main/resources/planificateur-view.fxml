<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.view.PlanificateurIntelligentViewController"
            minWidth="880" minHeight="560" prefWidth="1100" prefHeight="700"
            stylesheets="@styles.css"
            style="-fx-background-color: #f5f7fa;">

    <!-- Header removed from here to be integrated into scrollable content -->

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll" style="-fx-background-color: transparent;">
            <VBox spacing="0">
                <!-- INTEGRATED HEADER -->
                <VBox styleClass="header-scrollable">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button text="← Back" fx:id="backBtn" styleClass="nav-back-btn"
                               style="-fx-padding: 6 12; -fx-font-size: 11px; -fx-text-fill: white; -fx-font-weight: 800; -fx-cursor: hand; -fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 6;"/>
                        <VBox spacing="2">
                            <Label text="⚙️ Intelligent Planner Settings" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="Coming Soon - Optimize your workflow and daily capacity" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- INTERACTIVE SETTINGS -->
                <HBox spacing="24" style="-fx-padding: 0 20 20 20;">
                    
                    <!-- LEFT COLUMN: Settings -->
                    <VBox spacing="14" prefWidth="280" minWidth="240">
                        <VBox spacing="12" styleClass="dashboard-card-white">
                            <Label text="🛠️ Optimization Settings" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                            
                            <VBox spacing="6">
                                <Label text="Select Goal to Optimize" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <ComboBox fx:id="objectifComboBox" 
                                         promptText="Choose a goal"
                                         prefWidth="Infinity"
                                         style="-fx-background-radius: 6; -fx-padding: 5;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Daily Action Capacity" fx:id="capacityLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <Slider fx:id="capacitySlider" min="1" max="10" value="3" showTickLabels="true" showTickMarks="true" majorTickUnit="1" minorTickCount="0" snapToTicks="true"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Strategy" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                <HBox spacing="8">
                                    <ToggleButton fx:id="priorityToggle" text="🔥 Priority" selected="true" styleClass="toggle-btn-left" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <ToggleButton fx:id="balancedToggle" text="⚖️ Balanced" styleClass="toggle-btn-right" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                </HBox>
                            </VBox>

                            <Button text="Generate Smart Plan ✨" fx:id="generateBtn" onAction="#handleGeneratePlan" styleClass="btn-sky" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Stats/Tips Card -->
                        <VBox spacing="10" styleClass="dashboard-card-white" style="-fx-background-color: #f0f7ff; -fx-border-color: #bee3f8;">
                            <Label text="💡 Planner Tip" style="-fx-font-weight: bold; -fx-text-fill: #2b6cb0; -fx-font-size: 12px;"/>
                            <Label text="Setting a capacity of 3-5 actions per day is scientifically proven to reduce burnout and maintain long-term motivation." 
                                   wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #2c5282;"/>
                        </VBox>

                        <!-- AI SMART ADVICE CARD -->
                        <VBox spacing="10" styleClass="dashboard-card-white" style="-fx-background-color: #fdf2f2; -fx-border-color: #feb2b2;">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="🤖" style="-fx-font-size: 14px;"/>
                                <Label text="AI Smart Advice" style="-fx-font-weight: 900; -fx-text-fill: #9b2c2c; -fx-font-size: 12px;"/>
                            </HBox>
                            <Label fx:id="aiAdviceLabel" text="Select a goal to get AI-powered productivity tips!" 
                                   wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #c53030; -fx-font-style: italic;"/>
                        </VBox>
                    </VBox>

                    <!-- RIGHT COLUMN: Generated Schedule -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="Your Optimized Schedule" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                        
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <VBox fx:id="scheduleContainer" spacing="12">
                                <!-- Days will be injected here -->
                                <Label text="Select a goal and click 'Generate' to see your smart plan!" 
                                       style="-fx-text-fill: #94a3b8; -fx-font-style: italic; -fx-padding: 20; -fx-font-size: 12px;"/>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                </HBox>

                <!-- Use Other Modules -->
                <VBox spacing="14" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="💡 Start Here - Use These Features" 
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4A9EEB;"/>
                    
                    <HBox spacing="14" alignment="CENTER">
                        <!-- Create Goals -->
                        <VBox spacing="10" prefWidth="200" minHeight="180" alignment="TOP_CENTER"
                               onMouseClicked="#goToObjectif"
                               style="-fx-padding: 16; -fx-border-radius: 10; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-cursor: hand; -fx-border-color: #00d2ff; -fx-border-width: 0 0 0 4; -fx-border-style: solid;">
                            <Label text="🎯" style="-fx-font-size: 28px;"/>
                            <Label text="Create Goals" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #00d2ff;"/>
                            <Label text="Start by defining your personal goals with clear deadlines" 
                                   style="-fx-font-size: 11px; -fx-text-fill: #555555; -fx-text-alignment: center;"
                                   wrapText="true" VBox.vgrow="ALWAYS"/>
                            <Button text="Open Goals ▶" styleClass="btn-sky" style="-fx-font-size: 10px;"/>
                        </VBox>
                        
                        <!-- Set Milestones -->
                        <VBox spacing="10" prefWidth="200" minHeight="180" alignment="TOP_CENTER"
                               onMouseClicked="#goToMilestones"
                               style="-fx-padding: 16; -fx-border-radius: 10; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-cursor: hand; -fx-border-color: #3a7bd5; -fx-border-width: 0 0 0 4; -fx-border-style: solid;">
                            <Label text="📍" style="-fx-font-size: 28px;"/>
                            <Label text="Set Milestones" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3a7bd5;"/>
                            <Label text="Break down each goal into meaningful milestones" 
                                   style="-fx-font-size: 11px; -fx-text-fill: #555555; -fx-text-alignment: center;"
                                   wrapText="true" VBox.vgrow="ALWAYS"/>
                            <Button text="Open Milestones ▶" styleClass="btn-sky" style="-fx-font-size: 10px;"/>
                        </VBox>
                        
                        <!-- Plan Actions -->
                        <VBox spacing="10" prefWidth="200" minHeight="180" alignment="TOP_CENTER"
                               onMouseClicked="#goToActions"
                               style="-fx-padding: 16; -fx-border-radius: 10; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-cursor: hand; -fx-border-color: #f39c12; -fx-border-width: 0 0 0 4; -fx-border-style: solid;">
                            <Label text="⚡" style="-fx-font-size: 28px;"/>
                            <Label text="Plan Actions" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                            <Label text="Define specific action steps with priorities" 
                                   style="-fx-font-size: 11px; -fx-text-fill: #555555; -fx-text-alignment: center;"
                                   wrapText="true" VBox.vgrow="ALWAYS"/>
                            <Button text="Open Actions ▶" styleClass="btn-sky" style="-fx-font-size: 10px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
