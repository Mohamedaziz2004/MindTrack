<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.view.SelectionMenuViewController"
      fitToWidth="true"
      style="-fx-background-color: #f8fafc;"
      stylesheets="@styles.css">

    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: #f8fafc; -fx-padding: 16;">

        <!-- ===== WELCOME HEADER ===== -->
        <VBox spacing="4">
            <Label text="Welcome back, User! 👋" style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #4A9EEB;"/>
            <Label text="Here is what's happening with your goals today." style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
        </VBox>

        <!-- ===== QUICK STATS ROW ===== -->
        <HBox spacing="12" alignment="CENTER">
            <VBox styleClass="dashboard-card-white" minWidth="100" prefWidth="140" spacing="6">
                <Label text="TOTAL GOALS" styleClass="insight-stat-label"/>
                <Label fx:id="totalGoalsLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #4A9EEB;"/>
            </VBox>
            <VBox styleClass="dashboard-card-white" minWidth="100" prefWidth="140" spacing="6">
                <Label text="MILESTONES" styleClass="insight-stat-label"/>
                <Label fx:id="totalMilestonesLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #805ad5;"/>
            </VBox>
            <VBox styleClass="dashboard-card-white" minWidth="100" prefWidth="140" spacing="6">
                <Label text="QUICK ACTIONS" styleClass="insight-stat-label"/>
                <Label fx:id="totalActionsLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #e53e3e;"/>
            </VBox>
        </HBox>

        <!-- ===== TITLE ===== -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="Choose Your Focus" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #4A9EEB;"/>
            <Label text="What would you like to manage today?" style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
        </VBox>

        <!-- ===== FOCUS CARDS ===== -->
        <HBox alignment="CENTER" spacing="16">
            <!-- GOALS CARD -->
            <VBox styleClass="menu-card" alignment="CENTER" spacing="10" onMouseClicked="#openGoals">
                <Label text="🎯" styleClass="menu-card-icon"/>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Goals" styleClass="menu-card-title"/>
                    <Label text="Plan and track long-term objectives" styleClass="menu-card-desc" alignment="CENTER" wrapText="true" maxWidth="160"/>
                </VBox>
            </VBox>

            <!-- PLAN ACTION CARD -->
            <VBox styleClass="menu-card" alignment="CENTER" spacing="10" onMouseClicked="#openHabits">
                <Label text="📋" styleClass="menu-card-icon"/>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Plan d'Action" styleClass="menu-card-title"/>
                    <Label text="Définissez les étapes pour atteindre vos objectifs" styleClass="menu-card-desc" alignment="CENTER" wrapText="true" maxWidth="160"/>
                </VBox>
            </VBox>

            <!-- JALONS CARD -->
            <VBox styleClass="menu-card" alignment="CENTER" spacing="10" onMouseClicked="#openExercises">
                <Label text="🏁" styleClass="menu-card-icon"/>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Jalons" styleClass="menu-card-title"/>
                    <Label text="Suivez la progression de vos jalons clés" styleClass="menu-card-desc" alignment="CENTER" wrapText="true" maxWidth="160"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- ===== BOTTOM CARDS: Continue Improving + Tip ===== -->
        <GridPane hgap="16" vgap="0" maxWidth="600">
            <columnConstraints>
                <ColumnConstraints percentWidth="60"/>
                <ColumnConstraints percentWidth="40"/>
            </columnConstraints>

            <VBox spacing="12" GridPane.columnIndex="0" styleClass="dashboard-card-white">
                <Label text="Continue Improving" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                <VBox spacing="10">
                    <Label text="You're doing great! Keep tracking your progress to reach your objectives."
                           wrapText="true" style="-fx-text-fill: #718096; -fx-font-size: 12px;"/>
                    <Button text="Go to Goals 🎯" onAction="#goToGoals" styleClass="btn-sky"/>
                </VBox>
            </VBox>

            <VBox spacing="12" GridPane.columnIndex="1" styleClass="quote-card-blue">
                <Label text="💡 TIP" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 12px;"/>
                <Label text="Every step forward, no matter how small, brings you closer to your ultimate self."
                       wrapText="true" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600;"/>
            </VBox>
        </GridPane>

    </VBox>
</ScrollPane>
