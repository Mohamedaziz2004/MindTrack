<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.mindtrack.mindtrackfxx.controller.HumeurController" hgap="10" vgap="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>
    <Label text="Type" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <ComboBox fx:id="moodBox" GridPane.rowIndex="0" GridPane.columnIndex="1" />

    <Label text="Intensité" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <Spinner fx:id="intensitySpinner" GridPane.rowIndex="1" GridPane.columnIndex="1" />

    <Button fx:id="addBtn" text="Ajouter" onAction="#onAdd" GridPane.rowIndex="2" GridPane.columnIndex="1" />
    <Button text="Supprimer sélection" onAction="#onDeleteSelected" GridPane.rowIndex="2" GridPane.columnIndex="0" />

    <ListView fx:id="listView" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2" prefHeight="300" />
</GridPane>
